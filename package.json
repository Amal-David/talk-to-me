{
  "name": "talk-to-me-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Private text-only request/reply relay for owner-enrolled agents",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "talk-to-me": "bin/talk-to-me.mjs"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=neutral --external:cloudflare:workers --outfile=dist/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "dry-run": "wrangler deploy --dry-run --outdir dist/wrangler"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "5.20261021.1",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "typescript": "7.0.2",
    "wrangler": "4.151.3"
  },
  "overrides": {
    "miniflare@4.20260730.0": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    }
  }
}
